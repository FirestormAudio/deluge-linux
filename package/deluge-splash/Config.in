config BR2_PACKAGE_DELUGE_SPLASH
	bool "deluge-splash"
	help
	  Boot splash for the Deluge OLED: renders the deluge/linux wordmark,
	  a progress bar and the kernel version during boot, driven by /init.

	  Built from in-tree source under package/deluge-splash/splash (no
	  fetch). /init guards on [ -x /usr/bin/splash ], so an image built
	  without this package still boots — just with no splash.

if BR2_PACKAGE_DELUGE_SPLASH

config BR2_PACKAGE_DELUGE_SPLASH_NAME
	string "splash display name"
	default "deluge/linux"
	help
	  The name shown on the boot splash. Rendered with the 8x8 font, so
	  keep it short enough to fit the 128px-wide OLED (~16 chars).

endif
