+/*
+ *		role sysfs (Deluge manual host/peripheral switch)
+ */
+static ssize_t role_show(struct device *dev,
+			 struct device_attribute *attr, char *buf)
+{
+	struct usbhs_priv *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n",
+			  usbhs_mod_is_host(priv) > 0 ? "host" : "peripheral");
+}
+
+static ssize_t role_store(struct device *dev,
+			  struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct usbhs_priv *priv = dev_get_drvdata(dev);
+	int id, ret;
+
+	if (sysfs_streq(buf, "host"))
+		id = USBHS_HOST;
+	else if (sysfs_streq(buf, "peripheral"))
+		id = USBHS_GADGET;
+	else
+		return -EINVAL;
+
+	ret = usbhs_role_switch(priv, id);
+
+	return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_RW(role);
+
+static struct attribute *usbhs_role_attrs[] = {
+	&dev_attr_role.attr,
+	NULL,
+};
+
+static const struct attribute_group usbhs_role_group = {
+	.attrs = usbhs_role_attrs,
+};
