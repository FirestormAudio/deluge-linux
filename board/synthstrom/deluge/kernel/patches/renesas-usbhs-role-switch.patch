+/*
+ * Deluge manual role switch.
+ *
+ * The board straps the VBUS sense pin to 5V, so the autonomy hotplug path
+ * never sees VBUS drop and cannot switch roles on its own. Drive the switch
+ * explicitly here, reusing the enable/disable arms of usbhsc_hotplug().
+ */
+int usbhs_role_switch(struct usbhs_priv *priv, int id)
+{
+	struct platform_device *pdev = usbhs_priv_to_pdev(priv);
+	struct usbhs_mod *target;
+	int ret = 0;
+
+	if (id != USBHS_HOST && id != USBHS_GADGET)
+		return -EINVAL;
+
+	mutex_lock(&priv->role_lock);
+
+	/* serialize against the VBUS hotplug worker */
+	flush_delayed_work(&priv->notify_hotplug_work);
+
+	/* target module must be built in (host needs CONFIG_USB..._HCD) */
+	target = usbhs_mod_get(priv, id);
+	if (!target) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/* already in this role? */
+	if (usbhs_mod_get_current(priv) == target)
+		goto out;
+
+	/* tear down the current role (mirrors usbhsc_hotplug disable arm) */
+	if (usbhs_mod_get_current(priv)) {
+		usbhs_mod_call(priv, stop, priv);
+		usbhsc_bus_init(priv);
+		usbhs_mod_change(priv, -1);
+		usbhs_platform_call(priv, phy_reset, pdev);
+	}
+
+	/* bring up the requested role (mirrors usbhsc_hotplug enable arm) */
+	priv->forced_id = id;
+	usbhs_mod_change(priv, id);
+	usbhsc_set_buswait(priv);
+	usbhsc_bus_init(priv);
+	usbhs_mod_call(priv, start, priv);
+
+out:
+	mutex_unlock(&priv->role_lock);
+	return ret;
+}
+
