diff --git a/drivers/usb/renesas_usbhs/common.h b/drivers/usb/renesas_usbhs/common.h
index 3fb5bc94d..9c75b38cb 100644
--- a/drivers/usb/renesas_usbhs/common.h
+++ b/drivers/usb/renesas_usbhs/common.h
@@ -154,6 +154,7 @@ struct usbhs_priv;
 
 /* INTSTS0 */
 #define VBINT	(1 << 15)	/* VBUS0_0 and VBUS1_0 Interrupt Status */
+#define RESM	(1 << 14)	/* Resume Interrupt Status */
 #define DVST	(1 << 12)	/* Device State Transition Interrupt Status */
 #define CTRT	(1 << 11)	/* Control Stage Interrupt Status */
 #define BEMP	(1 << 10)	/* Buffer Empty Interrupt Status */
diff --git a/drivers/usb/renesas_usbhs/mod.c b/drivers/usb/renesas_usbhs/mod.c
index f2ea3e141..e5c3f2772 100644
--- a/drivers/usb/renesas_usbhs/mod.c
+++ b/drivers/usb/renesas_usbhs/mod.c
@@ -271,7 +271,7 @@ static irqreturn_t usbhs_interrupt(int irq, void *data)
 	if (irq_state.intsts0 & VBINT)
 		usbhs_mod_info_call(priv, irq_vbus, priv, &irq_state);
 
-	if (irq_state.intsts0 & DVST)
+	if (irq_state.intsts0 & (DVST | RESM))
 		usbhs_mod_call(priv, irq_dev_state, priv, &irq_state);
 
 	if (irq_state.intsts0 & CTRT)
@@ -337,7 +337,10 @@ void usbhs_irq_callback_update(struct usbhs_priv *priv, struct usbhs_mod *mod)
 			intenb0 |= CTRE;
 
 		if (mod->irq_dev_state)
-			intenb0 |= DVSE;
+			intenb0 |= DVSE | RSME;	/* RSME: detect bus resume from
+						 * suspend so the gadget can deliver
+						 * ->resume (RZ/A1 does not re-fire
+						 * DVST on resume). */
 
 		if (mod->irq_empty && mod->irq_bempsts) {
 			usbhs_write(priv, BEMPENB, mod->irq_bempsts);
diff --git a/drivers/usb/renesas_usbhs/mod_gadget.c b/drivers/usb/renesas_usbhs/mod_gadget.c
index 0c7fe109d..c277e52be 100644
--- a/drivers/usb/renesas_usbhs/mod_gadget.c
+++ b/drivers/usb/renesas_usbhs/mod_gadget.c
@@ -52,6 +52,7 @@ struct usbhsg_gpriv {
 #define USBHSG_STATUS_WEDGE		(1 << 2)
 #define USBHSG_STATUS_SELF_POWERED	(1 << 3)
 #define USBHSG_STATUS_SOFT_CONNECT	(1 << 4)
+#define USBHSG_STATUS_SUSPENDED		(1 << 5)
 	struct usbhsg_uep	uep[] __counted_by(uep_size);
 };
 
@@ -458,16 +459,34 @@ static int usbhsg_irq_dev_state(struct usbhs_priv *priv,
 	struct usbhsg_gpriv *gpriv = usbhsg_priv_to_gpriv(priv);
 	struct device *dev = usbhsg_gpriv_to_dev(gpriv);
 	int state = usbhs_status_get_device_state(irq_state);
+	bool resumed = irq_state->intsts0 & RESM;
 
 	gpriv->gadget.speed = usbhs_bus_get_speed(priv);
 
 	dev_dbg(dev, "state = %x : speed : %d\n", state, gpriv->gadget.speed);
 
-	if (gpriv->gadget.speed != USB_SPEED_UNKNOWN &&
+	if (!resumed && gpriv->gadget.speed != USB_SPEED_UNKNOWN &&
 	    (state & SUSPENDED_STATE)) {
-		if (gpriv->driver && gpriv->driver->suspend)
-			gpriv->driver->suspend(&gpriv->gadget);
-		usb_gadget_set_state(&gpriv->gadget, USB_STATE_SUSPENDED);
+		if (!(gpriv->status & USBHSG_STATUS_SUSPENDED)) {
+			gpriv->status |= USBHSG_STATUS_SUSPENDED;
+			dev_dbg(dev, "USB suspend (state=%x)\n", state);
+			if (gpriv->driver && gpriv->driver->suspend)
+				gpriv->driver->suspend(&gpriv->gadget);
+			usb_gadget_set_state(&gpriv->gadget, USB_STATE_SUSPENDED);
+		}
+	} else if (gpriv->status & USBHSG_STATUS_SUSPENDED) {
+		/*
+		 * Leaving suspend. Deliver ->resume so gadget functions re-arm
+		 * I/O: 7.1's u_serial gates RX/TX on the port's suspended flag,
+		 * which only gserial_resume() clears. Without this the CDC-ACM
+		 * console wedges after the first bus-idle (RX never re-armed, TX
+		 * dropped) — the UDC delivered ->suspend but never ->resume.
+		 */
+		gpriv->status &= ~USBHSG_STATUS_SUSPENDED;
+		dev_dbg(dev, "USB resume (state=%x)\n", state);
+		usb_gadget_set_state(&gpriv->gadget, USB_STATE_CONFIGURED);
+		if (gpriv->driver && gpriv->driver->resume)
+			gpriv->driver->resume(&gpriv->gadget);
 	}
 
 	return 0;
