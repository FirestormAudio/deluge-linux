 #define EPOUT_FBACK_IN_EN(_opts) ((_opts)->c_sync == USB_ENDPOINT_SYNC_ASYNC)
+/*
+ * Implicit feedback (out-of-tree, Deluge): when the function has BOTH async
+ * playback (OUT) and capture (IN), use the capture IN endpoint as the implicit
+ * feedback source instead of a dedicated feedback IN endpoint. This drops one
+ * ISO endpoint, so async full-duplex fits UDCs with few ISO pipes (RZ/A1
+ * usbhsc has only 2). Mirrors the Deluge firmware UAC2 (bSynchAddress=capture).
+ */
+#define IMPLICIT_FBACK_EN(_opts) \
+	(EPOUT_EN(_opts) && EPIN_EN(_opts) && \
+	 (_opts)->c_sync == USB_ENDPOINT_SYNC_ASYNC)
 
 struct f_uac2 {
 	struct g_audio g_audio;
