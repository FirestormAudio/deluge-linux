diff --git a/drivers/serial/Kconfig b/drivers/serial/Kconfig
index c86c883e..903eadaf 100644
--- a/drivers/serial/Kconfig
+++ b/drivers/serial/Kconfig
@@ -439,6 +439,14 @@ config DEBUG_UART_SEMIHOSTING
 	  start up driver model. The driver will be available until the real
 	  driver model serial is running.
 
+config DEBUG_UART_RTT
+	bool "SEGGER RTT"
+	depends on RTT_SERIAL
+	help
+	  Select this to enable the debug UART using the SEGGER RTT driver.
+	  Provides early console output (before driver model) into the same
+	  fixed-SRAM RTT control block used by the RTT serial driver.
+
 config DEBUG_UART_SCIF
 	bool "Renesas SCIF UART"
 	depends on SH || ARCH_RENESAS
@@ -962,6 +970,17 @@ config SEMIHOSTING_SERIAL
 	  semihosting. If you are not using a debugger, this driver will halt
 	  the boot.
 
+config RTT_SERIAL
+	bool "SEGGER RTT serial console"
+	depends on DM_SERIAL
+	help
+	  A serial console that transports characters through a SEGGER RTT
+	  control block in RAM, read and written by a J-Link debug probe via
+	  background memory access (no CPU halt, no exception vector, no
+	  breakpoints).  The control block sits at a fixed SRAM address so it
+	  survives U-Boot relocation.  Used for Synthstrom Deluge (RZ/A1L)
+	  bring-up, where no debug UART is accessible.
+
 config UNIPHIER_SERIAL
 	bool "Support for UniPhier on-chip UART"
 	depends on ARCH_UNIPHIER
