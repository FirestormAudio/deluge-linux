diff --git a/arch/arm/lib/semihosting.S b/arch/arm/lib/semihosting.S
index 6e1691a8..167b266a 100644
--- a/arch/arm/lib/semihosting.S
+++ b/arch/arm/lib/semihosting.S
@@ -16,20 +16,26 @@ ENTRY(smh_trap)
 #elif defined(CONFIG_CPU_V7M)
 	bkpt	#0xab
 #elif defined(CONFIG_SYS_THUMB_BUILD)
-	svc	#0xab
+	/* smh_trap is in a dedicated ARM-mode section (.text.smh_trap), so this is
+	 * the branch our Thumb U-Boot actually compiles.  Standard ARM-convention
+	 * SVC semihosting; J-Link is armed with the SVC vector (see #else branch). */
+	svc	#0x123456
 #else
-#if CONFIG_SYS_ARM_ARCH < 7
-	/* Before the ARMv7 exception model, svc (swi) clobbers lr */
-	mov	r2, lr
-#endif
+	/*
+	 * Deluge bring-up: J-Link traps semihosting via the SVC exception vector.
+	 * The GDB Server is armed with 'monitor semihosting enable <vector>' at
+	 * VBAR+0x08, and the jlink harness re-arms it at the relocated vector after
+	 * U-Boot moves VBAR during relocation.  Standard ARM-convention SVC number.
+	 * The trap is handled by the debugger before the CPU takes the exception,
+	 * so lr is not actually clobbered and 'bx lr' returns correctly.
+	 */
 	svc	#0x123456
 #endif
 
 #if defined(CONFIG_ARM64)
 	ret
-#elif CONFIG_SYS_ARM_ARCH < 7
-	bx	r2
 #else
+	/* BKPT preserves lr on all ARM arches, so no r2 save/restore is needed. */
 	bx	lr
 #endif
 
