#!/bin/sh
# SD-safe stop for the runit system. PID 1 is runsvdir (not busybox init), so
# plain busybox poweroff/reboot/halt can't signal init cleanly. Flush and
# unmount the rw SD (so its FAT isn't left dirty), then stop.
#
# This board (RZ/A1L) cannot gate its own power: no PMIC, no power-latch GPIO,
# and no kernel pm_power_off handler. reboot(RB_POWER_OFF) would just wedge the
# CPU with the panel still lit, so "poweroff" here means halt
# (reboot(RB_HALT_SYSTEM)): the CPU parks and the panels hold their last frame,
# then the user flips the hardware switch. Only reboot has a real power action
# (the RZ/A1 WDT restart handler).
#
# Verb comes from the symlink basename (reboot/poweroff/halt) or $1:
#   reboot            sync + unmount, then WDT restart
#   poweroff | halt   sync + unmount, then halt (park the CPU)
#   prepare           sync + unmount only, then return — lets a caller (the
#                     launcher) draw "SAFE TO POWER OFF" once the card is safe
#   stop              halt now, without repeating the sync + unmount
act=$(/bin/busybox basename "$0")
case "$act" in reboot|poweroff|halt) ;; *) act="${1:-poweroff}" ;; esac

sd_safe() {
	echo "deluge: $act — syncing and unmounting /sd" > /dev/kmsg 2>&1
	/bin/busybox sync
	/bin/busybox umount /sd 2>/dev/null || /bin/busybox umount -l /sd 2>/dev/null
	/bin/busybox sync
}

case "$act" in
	prepare)         sd_safe ;;
	stop)            exec /bin/busybox halt -f ;;
	reboot)          sd_safe; exec /bin/busybox reboot -f ;;
	poweroff|halt|*) sd_safe; exec /bin/busybox halt -f ;;
esac
