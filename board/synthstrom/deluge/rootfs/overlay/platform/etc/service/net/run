#!/bin/sh
exec >/dev/kmsg 2>&1
# usb0 is created by the NCM gadget function (see /usr/sbin/deluge-gadget).
while [ ! -e /sys/class/net/usb0 ]; do /bin/busybox sleep 1; done
/bin/busybox ifconfig usb0 192.168.7.2 netmask 255.255.255.0 up
echo "deluge: usb0 up at 192.168.7.2 (host: 192.168.7.1)"
exec /bin/busybox sleep infinity
