# BusyBox config fragment for the Deluge userspace. Enables the runit
# supervision applets (runit is not a Buildroot package; these ship in BusyBox).
# Merged onto Buildroot's default busybox.config at build time.
CONFIG_RUNSV=y
CONFIG_RUNSVDIR=y
CONFIG_FEATURE_RUNSVDIR_LOG=y
CONFIG_SV=y
CONFIG_SV_DEFAULT_SERVICE_DIR="/etc/service"
CONFIG_SVLOGD=y
CONFIG_CHPST=y
