# Base profile: the appliance rootfs every image is built on; no shell, no
# network. The runit service that launches the app slot (/usr/bin/deluge-app)
# lives in common, because deluge-mkimage bakes an app to that one path
# regardless of --profile. The slot itself is a stub here (overlay/base) until
# an app is baked in; platform fills it with the launcher instead.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DELUGE_PATH)/board/synthstrom/deluge/rootfs/overlay/common $(BR2_EXTERNAL_DELUGE_PATH)/board/synthstrom/deluge/rootfs/overlay/base"
